# Backend Environment Variables
# Copy this file to .env and fill in the values

# Database (defaults to SQLite if not set)
# DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — REQUIRED (generate a random secret: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=

# Admin seed — REQUIRED (created on first startup)
ADMIN_EMAIL=contacto@wingsnails.com.ar
# Generate hash: python -c "from app.auth import get_password_hash; print(get_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://wings-nails.vercel.app

# Rate limiting
# LOGIN_RATE_LIMIT=5/minute
